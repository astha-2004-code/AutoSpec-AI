# =====================================================================
# AutoSpec AI v2.0 - Environment Configuration
# =====================================================================

# Runtime Environment ("development" or "production")
AUTOSPEC_ENV=development
AUTOSPEC_LOG_LEVEL=INFO
AUTOSPEC_DEMO_MODE=true
AUTOSPEC_SECRET_KEY=dev-secret-change-in-production

# Neon PostgreSQL + pgvector (leave blank locally to use SQLite fallback)
# Pooled connection for FastAPI app runtime:
DATABASE_URL=
# Direct/unpooled Neon connection for Alembic migrations:
DATABASE_URL_UNPOOLED=

# Local Storage Directories
AUTOSPEC_STORAGE_DIR=./storage
AUTOSPEC_DEMO_DIR=./data/demo
AUTOSPEC_BENCHMARK_DIR=./storage/benchmarks

# Upload, Security & Concurrency Limits
AUTOSPEC_MAX_UPLOAD_SIZE_MB=50
AUTOSPEC_MAX_PDF_DB_MB=25
AUTOSPEC_MAX_PDF_PAGES=2500
AUTOSPEC_GUEST_UPLOAD_TTL_HOURS=24
AUTOSPEC_RATE_LIMIT_PER_MINUTE=90
AUTOSPEC_MAX_CONCURRENT_INGESTIONS=2
AUTOSPEC_REQUEST_TIMEOUT_SECONDS=35
AUTOSPEC_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Embeddings, Reranking & OCR
AUTOSPEC_EMBEDDING_MODEL=all-MiniLM-L6-v2
AUTOSPEC_EMBEDDING_DIM=384
AUTOSPEC_DEVICE=cpu
AUTOSPEC_OFFLINE_MODELS=false
AUTOSPEC_TOP_K=5
AUTOSPEC_RRF_K=60
AUTOSPEC_SEMANTIC_WEIGHT=0.5
AUTOSPEC_KEYWORD_WEIGHT=0.5
AUTOSPEC_MIN_RETRIEVAL_SCORE=0.005
AUTOSPEC_ENABLE_RERANKER=true
AUTOSPEC_USE_CROSS_ENCODER_MODEL=false
AUTOSPEC_ENABLE_OCR=false

# LLM Provider Configuration ("none" runs deterministic offline mode; "gemini" uses Gemini REST)
AUTOSPEC_LLM_PROVIDER=none
AUTOSPEC_LLM_MODEL=gemini-2.5-flash
AUTOSPEC_LLM_API_KEY=
AUTOSPEC_LLM_BASE_URL=

# Server Ports
AUTOSPEC_API_HOST=127.0.0.1
AUTOSPEC_API_PORT=8000
