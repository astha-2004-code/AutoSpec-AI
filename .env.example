# =====================================================================
# AutoSpec AI - Environment Configuration
# =====================================================================

# Application & Storage Settings
AUTOSPEC_STORAGE_DIR=./storage
AUTOSPEC_MAX_UPLOAD_SIZE_MB=100
AUTOSPEC_DEFAULT_PDF_PATH=

# Embeddings & Vector Index
AUTOSPEC_EMBEDDING_MODEL=all-MiniLM-L6-v2
AUTOSPEC_EMBEDDING_DIM=384
AUTOSPEC_DEVICE=cpu

# Retrieval Parameters
AUTOSPEC_TOP_K=5
AUTOSPEC_RRF_K=60
AUTOSPEC_SEMANTIC_WEIGHT=0.5
AUTOSPEC_KEYWORD_WEIGHT=0.5

# LLM Provider Configuration
# Supported providers: "none" (deterministic fallback), "openai", "anthropic", "gemini", "groq"
AUTOSPEC_LLM_PROVIDER=none
AUTOSPEC_LLM_MODEL=gpt-4o-mini
AUTOSPEC_LLM_API_KEY=
AUTOSPEC_LLM_BASE_URL=

# API & Server Settings
AUTOSPEC_API_HOST=127.0.0.1
AUTOSPEC_API_PORT=8000
AUTOSPEC_UI_PORT=8501
